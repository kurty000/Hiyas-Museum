rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && userDoc().exists
        && userDoc().data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn();

      // Any admin can create admin/curator staff profiles for any uid.
      // Users may also create their own profile doc.
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      // Admins can update any staff profile; users can update their own.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow delete: if isAdmin();
    }

    match /sensors/{sensorId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /alerts/{alertId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /logs/{logId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /contacts/{contactId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /deletedSensors/{sensorId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
